---
import "../styles/global.css";
import { articleCategories, articles } from "../data/articles";

const {
  title,
  description,
  canonicalPath = "/",
  pageTitle = "On this page",
} = Astro.props;

const siteUrl = new URL(canonicalPath, Astro.site);
const socialImage = new URL("/og/cnfcd-portal-cover.svg", Astro.site);

const navItems = [
  { href: "/", label: "首頁" },
  {
    href: "/library/life-insulin-resistance-complete-guide",
    label: "胰島素",
    match: ["/articles/insulin-blood-sugar"],
  },
  {
    href: "/library/middle-age-metabolism-after-40",
    label: "代謝",
    match: ["/articles/metabolic-repair"],
  },
  {
    href: "/library/life-fat-loss-plateau-complete-guide",
    label: "停滯期",
    match: ["/articles/myths"],
  },
  {
    href: "/library/life-eating-out-fat-loss-complete-guide",
    label: "外食",
    match: ["/articles/eating-out"],
  },
  { href: "/articles", label: "全部主題" },
];

const path = Astro.url.pathname;
const librarySlug = path.match(/^\/library\/([^/]+)/)?.[1];
const noteSlug = path.match(/^\/notes\/([^/]+)/)?.[1];
const currentArticle = librarySlug
  ? articles.find((article) => article.slug === librarySlug)
  : noteSlug
    ? articles.find((article) => article.slug === noteSlug)
    : undefined;
const currentArticleCategorySlug = currentArticle
  ? articleCategories.find(
      (category) => category.title === currentArticle.category,
    )?.slug
  : undefined;
const isNavActive = (item) =>
  path === item.href ||
  path.startsWith(`${item.href}/`) ||
  Boolean(item.match?.some((matchPath) => path.startsWith(matchPath)));
const activeNav = navItems.find(isNavActive)?.label ?? "知識文件";
const activeCategory =
  currentArticle?.category ??
  articleCategories.find((category) =>
    path.startsWith(`/articles/${category.slug}`),
  )?.title ??
  activeNav;

const sidebarGroups = [
  {
    title: "Pillar Topics",
    items: navItems,
  },
  {
    title: "All Themes",
    items: articleCategories.map((category) => ({
      href: `/articles/${category.slug}`,
      label: category.title,
    })),
  },
];
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl.toString()} />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="CNFCD 知識入口" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl.toString()} />
    <meta property="og:image" content={socialImage.toString()} />
    <meta property="og:image:alt" content="CNFCD 知識入口網站封面" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.toString()} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <div class="ambient-grid" aria-hidden="true"></div>
    <div class="site-shell">
      <header class="topbar">
        <div class="topbar-inner">
          <button
            class="menu-button"
            type="button"
            aria-label="開啟導覽"
            aria-expanded="false"
            aria-controls="docs-sidebar"
            data-nav-toggle
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
          <a class="site-brand" href="/" aria-label="回到首頁">
            <span class="brand-mark">C</span>
            <span>
              <strong>CNFCD</strong>
              <small>知識入口</small>
            </span>
          </a>
          <nav class="top-links" aria-label="主要導覽">
            {
              navItems.map((item) => (
                <a href={item.href} class:list={{ active: isNavActive(item) }}>
                  {item.label}
                </a>
              ))
            }
          </nav>
          <div class="context-pill" aria-label="目前頁面">
            <span>{activeCategory}</span>
          </div>
        </div>
      </header>

      <div class="docs-shell">
        <aside
          id="docs-sidebar"
          class="docs-sidebar"
          aria-label="文件導覽"
          data-nav
        >
          <div class="sidebar-kicker">Knowledge System</div>
          <nav class="side-links">
            {
              sidebarGroups.map((group) => (
                <section class="sidebar-group">
                  <p>{group.title}</p>
                  {group.items.map((item) => (
                    <a
                      href={item.href}
                      class:list={{
                        active:
                          path === item.href ||
                          path.startsWith(`${item.href}/`) ||
                          isNavActive(item) ||
                          item.href ===
                            `/articles/${currentArticleCategorySlug}`,
                      }}
                    >
                      <span>{item.label}</span>
                    </a>
                  ))}
                </section>
              ))
            }
          </nav>
        </aside>

        <main id="main-content" class="content-shell">
          <slot />
        </main>

        <aside class="toc-rail" aria-label="頁面脈絡">
          <section class="toc-card">
            <p class="eyebrow">{pageTitle}</p>
            <h2>{activeCategory}</h2>
            <p>{description}</p>
          </section>
          <section class="toc-card quiet-card">
            <p class="rail-label">Static Knowledge Base</p>
            <dl>
              <div>
                <dt>Format</dt>
                <dd>Astro / GitHub Pages</dd>
              </div>
              <div>
                <dt>Tone</dt>
                <dd>原理、導讀、非銷售</dd>
              </div>
              <div>
                <dt>Reading</dt>
                <dd>Mobile-first docs</dd>
              </div>
            </dl>
          </section>
        </aside>
      </div>
    </div>

    <script is:inline>
      const toggle = document.querySelector("[data-nav-toggle]");
      const nav = document.querySelector("[data-nav]");

      if (toggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
        toggle.addEventListener("click", () => {
          const expanded = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", String(!expanded));
          nav.dataset.open = String(!expanded);
        });
      }
    </script>
  </body>
</html>
