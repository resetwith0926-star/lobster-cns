---
const { cards } = Astro.props;
---

<div class="card-grid">
  {
    cards.map((card) => (
      <a class="feature-card" href={card.href}>
        <div>
          <p class="eyebrow">Guide</p>
          <h2>{card.title}</h2>
        </div>
        <p>{card.description}</p>
        <span class="card-arrow" aria-hidden="true">
          →
        </span>
      </a>
    ))
  }
</div>
