---
import BaseLayout from "../layouts/BaseLayout.astro";
import { principleArticles } from "../data/articles";

const pillarCards = [
  {
    title: "胰島素阻抗完整指南",
    description:
      "為什麼吃一樣的東西，身體卻越來越敏感？從判斷、機制到改善方向，一篇看懂。",
    href: "/library/life-insulin-resistance-complete-guide",
  },
  {
    title: "40 歲後代謝變慢的真相",
    description: "不是基礎代謝率降了，是身體節奏整個改了。",
    href: "/library/middle-age-metabolism-after-40",
  },
  {
    title: "減脂停滯期完整解析",
    description: "身體不是不配合，是進入了保護模式。",
    href: "/library/life-fat-loss-plateau-complete-guide",
  },
];

const topicRoutes = [
  {
    icon: "🍱",
    prompt: "我是外食族",
    title: "外食族減脂實戰",
    href: "/library/life-eating-out-fat-loss-complete-guide",
  },
  {
    icon: "🩺",
    prompt: "健檢出現脂肪肝",
    title: "脂肪肝代謝警訊",
    href: "/library/life-fatty-liver-nafld-reversal-stages",
  },
  {
    icon: "🤰",
    prompt: "產後瘦不下來",
    title: "產後恢復節奏",
    href: "/library/postpartum-weight-retention-metabolic-rhythm",
  },
  {
    icon: "💊",
    prompt: "想了解瘦瘦針",
    title: "GLP-1 完整真相",
    href: "/library/life-glp1-mechanism-muscle-loss-rebound",
  },
  {
    icon: "🧠",
    prompt: "壓力大就想吃",
    title: "壓力與皮質醇",
    href: "/library/life-stress-cortisol-metabolism-visceral-fat",
  },
];

const noteArticles = principleArticles
  .filter((article) => article.source === "觀念短文")
  .slice(0, 8);
---

<BaseLayout
  title="為什麼越努力減肥，身體越不配合？ | CNFCD.TW"
  description="CNFCD.TW 是代謝健康知識前哨，整理胰島素阻抗、中年代謝、減脂停滯、外食、脂肪肝、壓力與體重管理原理。"
  canonicalPath="/"
>
  <section class="hero panel hero-panel hook-panel">
    <p class="eyebrow">CNFCD.TW Knowledge Front</p>
    <h1>為什麼你越努力減肥，身體越不配合？</h1>
    <p class="hero-subtitle">
      不是意志力問題，也不是熱量算錯——<br />
      是身體的代謝節奏被打亂了。
    </p>
    <p class="hero-copy">
      你試過低卡、168、生酮、瘦瘦針，短期有用、長期復胖，最後越減越胖。這不是你不夠努力，是身體的胰島素訊號、脂肪動員機制與壓力荷爾蒙串成了一個你看不見的循環。這個網站不講銷售，只幫你看懂這個循環。
    </p>
    <a class="hero-action" href="/library/middle-age-metabolism-after-40">
      <span aria-hidden="true">▶</span>
      從這篇開始讀：40 歲後代謝變慢的真相
    </a>
  </section>

  <section class="panel pillar-section" aria-labelledby="home-pillars">
    <div class="section-heading">
      <p class="eyebrow">Pillar Guides</p>
      <h2 id="home-pillars">三個核心入口</h2>
      <p class="section-intro">
        先從這三篇建立主幹，再往外讀短文、案例資料與生活情境。這是本站的
        Hub-and-Spoke 閱讀結構。
      </p>
    </div>
    <div class="pillar-grid">
      {
        pillarCards.map((card, index) => (
          <a class="pillar-card" href={card.href}>
            <span class="pillar-number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
            <small>閱讀全文 →</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="panel topic-entry-section" aria-labelledby="home-topics">
    <div class="section-heading">
      <p class="eyebrow">Topic Entry</p>
      <h2 id="home-topics">你最近關心哪一件事？</h2>
    </div>
    <div class="topic-route-list">
      {
        topicRoutes.map((route) => (
          <a class="topic-route" href={route.href}>
            <span class="topic-icon" aria-hidden="true">
              {route.icon}
            </span>
            <span class="topic-prompt">{route.prompt}</span>
            <strong>{route.title}</strong>
            <span aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="panel note-library" aria-labelledby="home-notes">
    <div class="section-heading">
      <p class="eyebrow">Short Notes</p>
      <h2 id="home-notes">延伸閱讀 · 觀念短文</h2>
      <p class="section-intro">
        這些短文用比較小的切口拆解單一觀念，適合當作 Pillar 文章的補充資料。
      </p>
    </div>
    <ul class="note-link-list">
      {
        noteArticles.map((article) => (
          <li>
            <a href={article.url}>
              <span>{article.title}</span>
              <small>{article.description}</small>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="note-library-footer">
      <a class="text-link" href="/articles">查看全部主題 →</a>
    </div>
  </section>
</BaseLayout>
