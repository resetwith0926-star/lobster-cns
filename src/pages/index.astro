---
import FlowDiagram from "../components/FlowDiagram.astro";
import HeroCardGrid from "../components/HeroCardGrid.astro";
import ReadingPathList from "../components/ReadingPathList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const heroCards = [
  {
    title: "快速認識 CNFCD",
    description: "用 3 分鐘理解 CNFCD 的核心觀念與方法框架。",
    href: "/start",
  },
  {
    title: "核心觀念",
    description: "從代謝、血糖、腸道、睡眠與壓力，重新建立對身體的理解。",
    href: "/concepts",
  },
  {
    title: "文章地圖",
    description: "依照主題快速找到原網站文章與延伸閱讀。",
    href: "/articles",
  },
];

const audiencePathGroups = [
  {
    title: "人生階段",
    description:
      "年齡、產後、荷爾蒙與肌肉量變化，常常會改變身體處理食物的方式。",
    items: [
      {
        label: "中年代謝",
        title: "我 40 歲後開始卡住",
        description:
          "吃得和以前差不多，腰圍、體脂或健檢數字卻開始變化。先看胰島素、肌肉與睡眠的系統變化。",
        href: "/library/middle-age-metabolism-after-40",
      },
      {
        label: "中年男性",
        title: "我腰圍變大、精神下滑",
        description:
          "把啤酒肚、睪固酮變化、肌肉流失、壓力與睡眠放在同一張代謝地圖裡看。",
        href: "/library/life-male-metabolism-andropause-fat-loss-guide",
      },
      {
        label: "產後復原",
        title: "我是產後媽媽",
        description:
          "睡眠碎片化、壓力、哺乳期食慾與身體組成變化，常常需要一起看，而不是只看熱量。",
        href: "/library/postpartum-weight-retention-metabolic-rhythm",
      },
      {
        label: "更年期女性",
        title: "我停經前後腰圍變明顯",
        description:
          "從雌激素、脂肪分布、睡眠與胰島素敏感度，理解更年期前後的代謝變化。",
        href: "/library/life-menopause-obesity-hormones-waist-fat",
      },
    ],
  },
  {
    title: "反覆卡關",
    description:
      "如果你已經努力過很多次，先理解身體為什麼會進入保守、停滯或復胖循環。",
    items: [
      {
        label: "復胖循環",
        title: "我已經復胖很多次",
        description:
          "反覆節食、停滯、暴食、再重來，可能不是意志力壞掉，而是代謝適應與生活壓力在拉扯。",
        href: "/library/weight-regain-metabolic-adaptation-cycle",
      },
      {
        label: "吃很少仍卡",
        title: "我吃更少，身體卻更保守",
        description:
          "長期低熱量可能讓身體調低消耗、提高飢餓訊號，越努力越難維持。",
        href: "/library/life-eating-less-makes-you-fatter-metabolic-truth",
      },
      {
        label: "運動卡關",
        title: "我有運動，體重還是不動",
        description:
          "運動是好事，但如果血糖、睡眠、壓力與飲食結構不同步，體脂不一定會照預期下降。",
        href: "/library/life-exercise-but-not-losing-weight-5-reasons",
      },
      {
        label: "瘦胖體質",
        title: "我體重正常，但腰圍或體脂偏高",
        description:
          "BMI 正常不一定代表代謝健康，亞洲人常見的瘦胖型態需要看腰圍、肌肉與血脂血糖。",
        href: "/library/life-normal-weight-hidden-obesity-4-warning-signs",
      },
    ],
  },
  {
    title: "日常情境",
    description:
      "工作型態、外食、睡眠與情緒，會把代謝問題藏在每天很普通的選擇裡。",
    items: [
      {
        label: "外食上班族",
        title: "我忙、常外食、下午容易崩",
        description:
          "早餐店、便當、手搖飲與宵夜不只是選擇問題，也是血糖節奏與壓力恢復的問題。",
        href: "/notes/eating-out-stable-rhythm",
      },
      {
        label: "手搖甜食",
        title: "我下午一定想喝甜的",
        description: "把甜食渴望放回血糖、壓力、大腦獎賞與睡眠不足的脈絡裡看。",
        href: "/library/life-bubble-tea-blood-sugar-guide",
      },
      {
        label: "睡眠壓力",
        title: "我睡不好、壓力大、容易嘴饞",
        description:
          "睡眠與壓力會改變隔天的飢餓感、甜食渴望與脂肪動員條件，值得先被看見。",
        href: "/notes/sleep-appetite-metabolism",
      },
      {
        label: "腸胃發炎",
        title: "我常脹氣、排便亂、狀態起伏",
        description:
          "腸道菌相、短鏈脂肪酸、腸腦軸與慢性發炎，都可能影響食慾與精神狀態。",
        href: "/notes/gut-appetite-inflammation",
      },
    ],
  },
  {
    title: "健檢風險",
    description: "健檢紅字不是恐嚇，也不是診斷結論；它更像身體給你的代謝線索。",
    items: [
      {
        label: "健檢紅字",
        title: "我開始看到脂肪肝、血糖或三高警訊",
        description:
          "把健檢數字放回代謝脈絡，理解血糖、胰島素、肝臟與發炎訊號如何互相牽動。",
        href: "/library/health-check-red-flags-metabolic-map",
      },
      {
        label: "脂肪肝",
        title: "我被說有脂肪肝",
        description:
          "脂肪肝常和胰島素阻抗、果糖、內臟脂肪與三酸甘油脂有關，不能只看肝臟。",
        href: "/library/life-fatty-liver-nafld-reversal-stages",
      },
      {
        label: "血糖胰島素",
        title: "我空腹血糖正常，但還是不放心",
        description:
          "空腹血糖正常不一定代表代謝反應完全穩定，餐後波動與胰島素環境也值得理解。",
        href: "/library/life-normal-fasting-glucose-insulin-resistance",
      },
      {
        label: "血脂三高",
        title: "我三酸甘油脂、血壓或膽固醇偏高",
        description: "血脂、血壓、腰圍與血糖常常是同一套代謝背景的不同表現。",
        href: "/library/life-high-triglycerides-meaning-fat-loss",
      },
    ],
  },
];

const readingPaths = [
  { label: "新手必讀", href: "/articles/beginner" },
  { label: "胰島素與血糖", href: "/articles/insulin-blood-sugar" },
  { label: "腸道與發炎", href: "/articles/gut-inflammation" },
  { label: "睡眠與壓力", href: "/articles/sleep-stress" },
  { label: "外食族指南", href: "/articles/eating-out" },
  { label: "疾病與代謝風險", href: "/articles/metabolic-disease" },
  { label: "案例與研究整理", href: "/articles/cases-research" },
];

const learningPoints = [
  "代謝不是意志力問題",
  "體重管理不只看熱量",
  "睡眠與壓力會影響脂肪動員",
  "腸道與發炎會影響食慾與狀態",
  "外食族也能建立穩定節奏",
];
---

<BaseLayout
  title="看懂身體為什麼會卡住 | CNFCD 知識入口"
  description="CNFCD.TW 整理中年代謝、產後復原、復胖循環、健檢紅字、胰島素敏感度、腸道、睡眠與體重管理知識。"
  canonicalPath="/"
>
  <section class="hero panel hero-panel">
    <p class="eyebrow">CNFCD.TW</p>
    <h1>看懂身體為什麼會卡住</h1>
    <p class="hero-subtitle">
      中年代謝、產後復原、復胖循環、健檢紅字，許多看似不同的問題，其實來自同一套機制。
    </p>
    <p class="hero-copy">
      CNFCD.TW
      整理代謝健康、飲食節奏、胰島素敏感度、腸道、睡眠與體重管理的知識。這裡不談銷售，先幫你看懂。
    </p>
  </section>

  <HeroCardGrid cards={heroCards} />

  <section class="panel audience-panel">
    <div class="section-heading">
      <p class="eyebrow">Audience Routes</p>
      <h2>你是哪種人？</h2>
      <p class="section-intro">
        如果你剛進來，不必先懂所有名詞。先從自己的情境進入，再回到主題分類慢慢讀。
      </p>
    </div>
    <div class="audience-groups">
      {
        audiencePathGroups.map((group) => (
          <section class="audience-group">
            <div class="audience-group-head">
              <h3>{group.title}</h3>
              <p>{group.description}</p>
            </div>
            <div class="audience-grid">
              {group.items.map((item) => (
                <a class="audience-card" href={item.href}>
                  <span>{item.label}</span>
                  <h4>{item.title}</h4>
                  <p>{item.description}</p>
                  <small aria-hidden="true">閱讀路徑 →</small>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <FlowDiagram />

  <section class="panel">
    <div class="section-heading">
      <p class="eyebrow">Learning Outcomes</p>
      <h2>你將學到什麼</h2>
    </div>
    <ul class="bullet-list">
      {learningPoints.map((point) => <li>{point}</li>)}
    </ul>
  </section>

  <ReadingPathList items={readingPaths} />
</BaseLayout>
