---
import FlowDiagram from "../components/FlowDiagram.astro";
import HeroCardGrid from "../components/HeroCardGrid.astro";
import ReadingPathList from "../components/ReadingPathList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const heroCards = [
  {
    title: "快速認識 CNFCD",
    description: "用 3 分鐘理解 CNFCD 的核心觀念與方法框架。",
    href: "/start",
  },
  {
    title: "核心觀念",
    description: "從代謝、血糖、腸道、睡眠與壓力，重新建立對身體的理解。",
    href: "/concepts",
  },
  {
    title: "文章地圖",
    description: "依照主題快速找到原網站文章與延伸閱讀。",
    href: "/articles",
  },
];

const audiencePaths = [
  {
    label: "中年代謝",
    title: "我 40 歲後開始卡住",
    description:
      "吃得和以前差不多，腰圍、體脂或健檢數字卻開始變化。先看胰島素、肌肉與睡眠的系統變化。",
    href: "/library/middle-age-metabolism-after-40",
  },
  {
    label: "產後復原",
    title: "我是產後媽媽",
    description:
      "睡眠碎片化、壓力、飢餓感與身體組成變化，常常需要一起看，而不是只看熱量。",
    href: "/articles/sleep-stress",
  },
  {
    label: "復胖循環",
    title: "我已經復胖很多次",
    description:
      "反覆節食、停滯、暴食、再重來，可能不是意志力壞掉，而是代謝適應與生活壓力在拉扯。",
    href: "/notes/plateau-and-metabolic-adaptation",
  },
  {
    label: "健檢紅字",
    title: "我開始看到脂肪肝、血糖或三高警訊",
    description:
      "把健檢數字放回代謝脈絡，理解血糖、胰島素、肝臟與發炎訊號如何互相牽動。",
    href: "/articles/metabolic-disease",
  },
  {
    label: "外食上班族",
    title: "我忙、常外食、下午容易崩",
    description:
      "早餐店、便當、手搖飲與宵夜不只是選擇問題，也是血糖節奏與壓力恢復的問題。",
    href: "/notes/eating-out-stable-rhythm",
  },
  {
    label: "睡眠壓力",
    title: "我睡不好、壓力大、容易嘴饞",
    description:
      "睡眠與壓力會改變隔天的飢餓感、甜食渴望與脂肪動員條件，值得先被看見。",
    href: "/notes/sleep-appetite-metabolism",
  },
];

const readingPaths = [
  { label: "新手必讀", href: "/articles/beginner" },
  { label: "胰島素與血糖", href: "/articles/insulin-blood-sugar" },
  { label: "腸道與發炎", href: "/articles/gut-inflammation" },
  { label: "睡眠與壓力", href: "/articles/sleep-stress" },
  { label: "外食族指南", href: "/articles/eating-out" },
  { label: "疾病與代謝風險", href: "/articles/metabolic-disease" },
  { label: "案例與研究整理", href: "/articles/cases-research" },
];

const learningPoints = [
  "代謝不是意志力問題",
  "體重管理不只看熱量",
  "睡眠與壓力會影響脂肪動員",
  "腸道與發炎會影響食慾與狀態",
  "外食族也能建立穩定節奏",
];
---

<BaseLayout
  title="看懂身體為什麼會卡住 | CNFCD 知識入口"
  description="CNFCD.TW 整理中年代謝、產後復原、復胖循環、健檢紅字、胰島素敏感度、腸道、睡眠與體重管理知識。"
  canonicalPath="/"
>
  <section class="hero panel hero-panel">
    <p class="eyebrow">CNFCD.TW</p>
    <h1>看懂身體為什麼會卡住</h1>
    <p class="hero-subtitle">
      中年代謝、產後復原、復胖循環、健檢紅字，許多看似不同的問題，其實來自同一套機制。
    </p>
    <p class="hero-copy">
      CNFCD.TW
      整理代謝健康、飲食節奏、胰島素敏感度、腸道、睡眠與體重管理的知識。這裡不談銷售，先幫你看懂。
    </p>
  </section>

  <HeroCardGrid cards={heroCards} />

  <section class="panel audience-panel">
    <div class="section-heading">
      <p class="eyebrow">Audience Routes</p>
      <h2>你是哪種人？</h2>
      <p class="section-intro">
        如果你剛進來，不必先懂所有名詞。先從自己的情境進入，再回到主題分類慢慢讀。
      </p>
    </div>
    <div class="audience-grid">
      {
        audiencePaths.map((item) => (
          <a class="audience-card" href={item.href}>
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <small aria-hidden="true">閱讀路徑 →</small>
          </a>
        ))
      }
    </div>
  </section>

  <FlowDiagram />

  <section class="panel">
    <div class="section-heading">
      <p class="eyebrow">Learning Outcomes</p>
      <h2>你將學到什麼</h2>
    </div>
    <ul class="bullet-list">
      {learningPoints.map((point) => <li>{point}</li>)}
    </ul>
  </section>

  <ReadingPathList items={readingPaths} />
</BaseLayout>
