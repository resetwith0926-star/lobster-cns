---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articleCategories, articles } from "../../data/articles";

export function getStaticPaths() {
  return articleCategories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const items = articles
  .filter((article) => article.category === category.title)
  .sort((a, b) => a.recommendedOrder - b.recommendedOrder);

const linkLabel = (source) => {
  if (source === "知識整理") return "閱讀站內文章";
  if (source === "觀念短文") return "閱讀站內短文";
  return "前往原站文章";
};
---

<BaseLayout
  title={`${category.title} | CNFCD 文章地圖`}
  description={category.description}
  canonicalPath={`/articles/${category.slug}`}
>
  <section class="panel page-heading">
    <p class="eyebrow">Reading Route</p>
    <h1>{category.title}</h1>
    <p class="section-intro">{category.description}</p>
  </section>

  <section class="article-stack" aria-label={category.title}>
    {
      items.map((article) => (
        <article class="panel article-card">
          <div class="article-meta-row">
            <span class="article-order">
              推薦順序 {String(article.recommendedOrder).padStart(2, "0")}
            </span>
            <span class="source-badge">{article.source}</span>
          </div>
          <h2>{article.title}</h2>
          <p>{article.description}</p>
          <div class="tag-row" aria-label="文章標籤">
            {article.tags.map((tag) => (
              <span class="chip">{tag}</span>
            ))}
          </div>
          <a
            class="text-link"
            href={article.url}
            target={article.url.startsWith("http") ? "_blank" : undefined}
            rel={article.url.startsWith("http") ? "noreferrer" : undefined}
          >
            {linkLabel(article.source)} →
          </a>
        </article>
      ))
    }
  </section>
</BaseLayout>
