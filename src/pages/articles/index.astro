---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  articleStats,
  articleCategories,
  articles,
  principleArticles,
} from "../../data/articles";

const groupedArticles = articleCategories.map((category) => ({
  ...category,
  items: articles
    .filter((article) => article.category === category.title)
    .sort((a, b) => a.recommendedOrder - b.recommendedOrder),
}));

const featuredPrinciples = principleArticles.slice(0, 4);
---

<BaseLayout
  title="胰島素阻抗、代謝修復與脂肪肝文章地圖 | CNFCD.TW"
  description="依照胰島素阻抗、血糖、脂肪肝、睡眠壓力、腸道發炎與外食情境，找到站內知識文章與閱讀順序。"
  canonicalPath="/articles"
>
  <section class="panel page-heading">
    <p class="eyebrow">Article Map</p>
    <h1>CNFCD 文章地圖</h1>
    <p class="section-intro">
      這一頁把站內原理短文與整理文章放成同一張知識地圖。只收錄
      CNFCD、代謝、血糖、腸道、睡眠、外食與疾病風險相關內容，不放方案、費用、加入流程或銷售導向頁面。
    </p>
  </section>

  <section class="panel boundary-panel" aria-label="內容分工原則">
    <div>
      <p class="eyebrow">Content Boundary</p>
      <h2>.tw 的任務：先讓人看懂身體</h2>
    </div>
    <p>
      CNFCD.TW
      是知識前哨，回答「為什麼瘦不下來」「胰島素阻抗是什麼」「脂肪肝與血糖有什麼關係」這類問題型搜尋。服務故事、方案、費用與加入流程不放在這裡。
    </p>
  </section>

  <section class="library-stats" aria-label="文章庫統計">
    <div class="stat-panel">
      <span>{articleStats.total}</span>
      <p>知識條目</p>
    </div>
    <div class="stat-panel">
      <span>{articleStats.principle}</span>
      <p>站內原理短文</p>
    </div>
    <div class="stat-panel">
      <span>{articleStats.imported}</span>
      <p>站內整理文章</p>
    </div>
  </section>

  <section class="principle-strip" aria-label="推薦先讀">
    <div class="section-heading inline-heading">
      <p class="eyebrow">Start Here</p>
      <h2>先讀這幾篇原理</h2>
    </div>
    <div class="compact-list">
      {
        featuredPrinciples.map((article) => (
          <a href={article.url}>
            <span>{article.title}</span>
            <small>{article.category}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="category-overview" aria-label="文章分類">
    {
      groupedArticles.map((group) => (
        <article class="panel category-card">
          <div class="category-card-head">
            <div>
              <p class="eyebrow">Category</p>
              <h2>{group.title}</h2>
            </div>
            <a class="text-link" href={`/articles/${group.slug}`}>
              查看路徑 →
            </a>
          </div>
          <p>{group.description}</p>
          <p class="category-count">{group.items.length} 篇</p>
          <ul class="article-preview-list">
            {group.items.slice(0, 4).map((article) => (
              <li>
                <a
                  href={article.url}
                  target={article.url.startsWith("http") ? "_blank" : undefined}
                  rel={
                    article.url.startsWith("http") ? "noreferrer" : undefined
                  }
                >
                  <span>{article.title}</span>
                  <small>{article.source}</small>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>
</BaseLayout>
