---
import ArticleVisual from "../../components/ArticleVisual.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categorySlugMap, articles } from "../../data/articles";

export function getStaticPaths() {
  return articles
    .filter((article) => article.content)
    .map((article) => ({
      params: { slug: article.slug },
      props: { article },
    }));
}

const { article } = Astro.props;
const content = article.content;
const updatedDate = content
  ? new Intl.DateTimeFormat("zh-Hant-TW", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).format(new Date(content.importedAt))
  : "";

const normalizeHref = (href) => href.replace(/\/$/, "");
const articleUrlSet = new Set(articles.map((item) => normalizeHref(item.url)));
const manualRelated =
  content?.related
    ?.map((item) => ({ ...item, href: normalizeHref(item.href) }))
    .filter((item) => item.href.startsWith("/"))
    .filter((item) => articleUrlSet.has(item.href))
    .filter((item) => item.href !== article.url) ?? [];
const manualRelatedHrefs = new Set(manualRelated.map((item) => item.href));
const generatedRelated = articles
  .filter((candidate) => candidate.slug !== article.slug)
  .filter((candidate) => candidate.url.startsWith("/"))
  .filter((candidate) => !manualRelatedHrefs.has(candidate.url))
  .map((candidate) => {
    const sharedTags = candidate.tags.filter((tag) =>
      article.tags.includes(tag),
    );
    const score =
      (candidate.category === article.category ? 6 : 0) + sharedTags.length * 2;

    return { candidate, score };
  })
  .filter((item) => item.score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      a.candidate.recommendedOrder - b.candidate.recommendedOrder,
  )
  .slice(0, 6)
  .map(({ candidate }) => ({
    label: candidate.title,
    href: candidate.url,
  }));
const relatedItems = [...manualRelated, ...generatedRelated].slice(0, 6);
---

<BaseLayout
  title={`${article.title} | CNFCD 知識庫`}
  description={article.description}
  canonicalPath={`/library/${article.slug}`}
>
  <article class="knowledge-article">
    <header class="panel page-heading article-hero">
      <p class="eyebrow">Knowledge Article</p>
      <h1>{article.title}</h1>
      <p class="section-intro">{article.description}</p>
      <div class="note-meta">
        <span>{article.category}</span>
        <span>站內知識整理</span>
        <span>更新 {updatedDate}</span>
      </div>
    </header>

    {
      content && content.summary.length > 0 && (
        <section class="panel digest-panel" aria-label="文章摘要">
          <div class="section-heading inline-heading">
            <p class="eyebrow">Digest</p>
            <h2>先抓住這篇的核心</h2>
          </div>
          <div class="digest-copy">
            {content.summary.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      )
    }

    {
      content && content.keyTakeaways.length > 0 && (
        <section class="takeaway-grid" aria-label="重點整理">
          {content.keyTakeaways.map((item, index) => (
            <div class="takeaway-card">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{item}</p>
            </div>
          ))}
        </section>
      )
    }

    {content && <ArticleVisual visual={content.visual} />}

    {
      content && (
        <section class="panel article-body" aria-label="文章內容">
          <p class="eyebrow">Article</p>
          {content.blocks.map((block) => {
            if (block.type === "heading") return <h2>{block.text}</h2>;
            if (block.type === "quote")
              return <blockquote>{block.text}</blockquote>;
            if (block.type === "list") {
              return (
                <ul>
                  {block.items?.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              );
            }
            return <p>{block.text}</p>;
          })}
        </section>
      )
    }

    {
      content && (relatedItems.length || content.references?.length) && (
        <section class="panel related-panel" aria-label="延伸閱讀與資料來源">
          {relatedItems.length > 0 && (
            <div>
              <div class="section-heading inline-heading">
                <p class="eyebrow">Next Reading</p>
                <h2>站內延伸閱讀</h2>
              </div>
              <ul class="reading-list">
                {relatedItems.map((item) => (
                  <li>
                    <a href={item.href}>
                      <span>{item.label}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {content.references && content.references.length > 0 && (
            <div>
              <div class="section-heading inline-heading">
                <p class="eyebrow">References</p>
                <h2>資料來源</h2>
              </div>
              <ul class="reading-list reference-list">
                {content.references.map((item) => (
                  <li>
                    <a href={item.href} target="_blank" rel="noreferrer">
                      <span>{item.label}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )
    }

    <nav class="panel pager-nav" aria-label="文章導覽">
      <a href={`/articles/${categorySlugMap[article.category]}`}>
        <span>回到「{article.category}」分類</span>
        <span aria-hidden="true">→</span>
      </a>
      <a href="/articles">
        <span>回到文章地圖</span>
        <span aria-hidden="true">→</span>
      </a>
    </nav>
  </article>
</BaseLayout>
